* text=auto

# Unity YAML: text, LF (Unity writes LF), no LFS
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
*.cs text diff=csharp
*.ps1 text eol=crlf

# Binaries
