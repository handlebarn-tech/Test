/* Slice UI (UX_SLICE §5-6 tokens). Reference 1920x1080, title-safe 96/54 px. */
.slice-root {
    --ok: #56B4E9; --warn: #E69F00; --bad: #D55E00; --accent: #009E73;
    --bg: #15181c; --panel: #1d2127; --card: #262b33; --line: #3a414c;
    --t1: #f2f4f7; --t2: #c3c9d2; --t3: #8f98a5;
    flex-grow: 1;
    color: var(--t1);
    font-size: 22px;
}
.slice-root Label { color: var(--t1); white-space: normal; }
.slice-root Button {
    background-color: var(--card); color: var(--t1); border-color: var(--line); border-width: 2px; border-radius: 6px;
    min-height: 56px; padding: 8px 18px; margin: 6px; font-size: 22px;
}
.slice-root Button:hover { border-color: var(--accent); }
.slice-root Button:disabled { opacity: 0.35; }
.slice-root .primary { background-color: var(--accent); border-color: var(--accent); }
.st-ok { color: var(--ok); }
.slice-root .st-warn { color: var(--warn); }
.slice-root .st-bad { color: var(--bad); }

.jar-layer, .screen, .toasts, .debug { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.jar-layer { }
.jar-label { position: absolute; background-color: rgba(21,24,28,0.85); color: var(--warn); font-size: 18px; padding: 2px 6px; -unity-font-style: bold; }

.hud { position: absolute; top: 54px; right: 96px; align-items: flex-end; background-color: rgba(21,24,28,0.6); padding: 10px 16px; border-radius: 6px; }
.hud-clock { font-size: 26px; }
.hud-sales, .hud-queue { font-size: 22px; color: var(--t2); }
.prompt { position: absolute; bottom: 160px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 26px; }

.screen { align-items: center; justify-content: center; }
.screen.dim { background-color: rgba(0,0,0,0.55); }

.toasts { left: 96px; top: 54px; right: auto; bottom: auto; width: 560px; }
.toast { background-color: var(--panel); border-left-width: 6px; border-color: var(--ok); padding: 10px 14px; margin-bottom: 8px; border-radius: 4px; }
.toast.st-warn { border-color: var(--warn); }
.toast.st-bad { border-color: var(--bad); }
/* Register toasts never cover the register: at 100 % they fit the 364 px left of the centred panel; the scaled register fills
   the safe area, so they drop to bottom-left under the cart lines. */
.register-open .toasts { width: 340px; }
.text-125.register-open .toasts, .text-150.register-open .toasts { top: auto; bottom: 54px; width: 560px; }
.toast-2 { color: var(--t2); font-size: 18px; }

.dialogue { position: absolute; bottom: 54px; left: 96px; right: 96px; flex-direction: row; justify-content: center; }
.dialogue-sub { width: 1200px; background-color: rgba(21,24,28,0.9); padding: 16px 20px; border-radius: 6px; }
.speaker { font-size: 18px; color: var(--t3); }
.line { font-size: 28px; }
.dialogue-options { width: 320px; justify-content: flex-end; }

.terminal { width: 1600px; height: 900px; background-color: var(--panel); border-radius: 8px; padding: 20px 28px; }
.request-strip { flex-direction: row; background-color: var(--bg); padding: 10px 14px; border-radius: 6px; margin-bottom: 12px; }
.archetype { color: var(--t3); font-size: 18px; margin-right: 14px; }
.request { flex-shrink: 1; }
.terminal-body { flex-grow: 1; }
.h1 { font-size: 28px; -unity-font-style: bold; margin: 6px 0; }
.row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.col { flex-grow: 1; flex-basis: 0; padding: 0 12px; }
.tiles { flex-direction: row; flex-wrap: wrap; }
.tile { width: 300px; height: 120px; font-size: 26px; }
.tile.selected { border-color: var(--accent); border-width: 4px; }
.banner { background-color: var(--bg); padding: 8px 12px; border-radius: 4px; margin: 6px 0; }
.cards { flex-grow: 1; }
.cards > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; }
.card { width: 480px; background-color: var(--card); border-radius: 8px; padding: 14px 16px; margin: 8px; border-width: 2px; border-color: var(--line); }
.card.is-top { border-left-width: 8px; border-left-color: var(--accent); }
.card-name { font-size: 28px; -unity-font-style: bold; }
.card-sub, .card-cluster, .card-grams { color: var(--t2); font-size: 18px; }
.price { font-size: 36px; margin: 6px 0; }
.chip { font-size: 18px; }
.message { margin: 6px 0; }
.more { align-self: flex-start; }
.back { position: absolute; right: 20px; bottom: 16px; }
.evidence { color: var(--t3); font-size: 18px; margin-top: 10px; }
.bar { flex-direction: row; align-items: center; margin: 3px 0; }
.bar-name { width: 220px; font-size: 18px; color: var(--t2); }
.bar-track { flex-grow: 1; height: 16px; background-color: var(--bg); }
.bar-fill { height: 16px; background-color: var(--ok); }
.bar-value { width: 48px; -unity-text-align: middle-right; font-size: 18px; }
.caveat { color: var(--t3); font-size: 18px; margin-top: 10px; }

.pos { width: 1000px; min-height: 900px; background-color: var(--panel); border-radius: 8px; padding: 20px 28px; }

/* GAME-007: register at 125/150 % text = two columns in the full safe area, never scrolls (UX_COUNTER_INTEL §10). */
.text-125 .pos, .text-150 .pos { width: 1728px; height: 972px; min-height: 0; flex-direction: row; }
.text-125 .pos-col, .text-150 .pos-col { flex-grow: 1; flex-basis: 0; padding: 0 12px; }
.text-125 .pos Label, .text-125 .pos Button { font-size: 28px; }
.text-150 .pos Label, .text-150 .pos Button { font-size: 33px; }
.text-125 .pos .h1 { font-size: 35px; }
.text-150 .pos .h1 { font-size: 42px; }
.text-125 .pos .price-line.total Label { font-size: 45px; }
.text-150 .pos .price-line.total Label { font-size: 54px; }

/* Cart lines (UX_PS1 §2, REVIEW-W4W m1): name and batch·tier ellipsize; stepper, grams, price and ✕ are fixed columns. */
.cart-line { flex-direction: row; align-items: center; min-height: 80px; border-bottom-width: 1px; border-color: var(--line); }
.cart-info { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; }
.slice-root .cart-name, .slice-root .cart-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.slice-root .cart-sub { color: var(--t2); font-size: 18px; }
.slice-root .cart-step { width: 56px; min-width: 56px; padding: 0; flex-shrink: 0; }
.cart-grams { width: 84px; flex-shrink: 0; -unity-text-align: middle-center; }
.cart-price { width: 120px; flex-shrink: 0; -unity-text-align: middle-right; }
.text-125 .cart-line { min-height: 96px; }
.text-150 .cart-line { min-height: 112px; }
.text-125 .pos .cart-sub { font-size: 22px; }
.text-150 .pos .cart-sub { font-size: 27px; }
.text-125 .pos .cart-step { width: 68px; min-width: 68px; }
.text-150 .pos .cart-step { width: 80px; min-width: 80px; }
.text-125 .cart-grams { width: 104px; }
.text-150 .cart-grams { width: 124px; }
.text-125 .cart-price { width: 150px; }
.text-150 .cart-price { width: 176px; }

/* Limit meter (UX_PS1 §3): 440 px bar, label left, value right, 75 % tick; widens with its column at 125/150 %. */
.meter { width: 440px; margin: 10px 0; }
.text-125 .meter, .text-150 .meter { width: auto; }
.meter-head { flex-direction: row; justify-content: space-between; }
.slice-root .meter-label, .slice-root .meter-value { white-space: nowrap; }
.meter-track { height: 18px; background-color: var(--bg); margin: 4px 0; }
.meter-fill { height: 18px; background-color: var(--ok); }
.meter-amber .meter-fill { background-color: var(--warn); }
.meter-red .meter-fill { background-color: var(--bad); }
.meter-tick { position: absolute; top: -3px; width: 2px; height: 24px; background-color: var(--t2); }
.meter-hint { border-width: 1px; border-color: var(--bad); border-radius: 4px; padding: 4px 8px; margin-top: 4px; }
.price-line { flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-color: var(--line); padding: 4px 0; }
.price-line.total Label { font-size: 36px; }
.amount { -unity-text-align: middle-right; }
.scale, .hint { color: var(--t2); font-size: 18px; margin: 6px 0; }

/* GAME-008 cover prompt (UX_PS1 §4, 800x300; height grows and the body wraps at 125/150 %). */
.cover-prompt { width: 800px; min-height: 300px; background-color: var(--panel); border-radius: 8px; padding: 20px 28px; justify-content: space-between; }
.text-125 .cover-prompt { width: 1000px; }
.text-150 .cover-prompt { width: 1200px; }
.text-125 .cover-prompt Label, .text-125 .cover-prompt Button { font-size: 28px; }
.text-150 .cover-prompt Label, .text-150 .cover-prompt Button { font-size: 33px; }
.text-125 .cover-prompt .h1 { font-size: 35px; }
.text-150 .cover-prompt .h1 { font-size: 42px; }

/* GAME-008 ID panel (UX_PS1 §4, 1200x900 at left; ID-1 card 770x486, vertical IDs portrait). */
.id-panel { position: absolute; left: 96px; top: 90px; width: 1200px; height: 900px; background-color: var(--panel); border-radius: 8px; padding: 20px 28px; }
.id-head { flex-direction: row; justify-content: space-between; align-items: center; }
.id-today { color: var(--t2); }
.id-body { flex-direction: row; flex-grow: 1; margin-top: 12px; }
.id-card { background-color: #e9e4d8; border-radius: 18px; padding: 14px 18px; flex-shrink: 0; }
.id-h { width: 770px; height: 486px; }
.id-v { width: 400px; height: 635px; }
.slice-root .id-card Label { color: #1a1a1a; }
.slice-root .id-band { font-size: 22px; -unity-font-style: bold; color: #1b3a6b; margin-bottom: 10px; }
.id-inner { flex-direction: row; flex-grow: 1; }
.id-v .id-inner { flex-direction: column; }
.id-photo { width: 180px; height: 230px; background-color: #9aa3ad; border-radius: 6px; margin-right: 18px; flex-shrink: 0; }
.id-v .id-photo { width: 150px; height: 190px; margin: 0 0 12px 0; }
.id-fields { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.id-field { flex-direction: row; align-items: center; margin: 3px 0; }
.slice-root .id-key { width: 110px; font-size: 16px; color: #555; flex-shrink: 0; }
.slice-root .id-value { font-size: 24px; white-space: nowrap; }
.slice-root .id-name { overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
/* On the card a value never spills past the edge; when a portrait card can't fit one at 150 %, the readout column carries it (§10). */
.slice-root .id-card .id-value { overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }
.id-side { flex-grow: 1; padding-left: 24px; justify-content: flex-end; }
.id-readout { display: none; }
.id-buttons { }
/* 125/150 %: the panel fills the safe area, the card scales, and DOB / EXP / TYPE / FORMAT are repeated full size beside it. */
.text-125 .id-panel, .text-150 .id-panel { left: 96px; top: 54px; width: 1728px; height: 972px; }
.text-125 .id-panel Label, .text-125 .id-panel Button { font-size: 28px; }
.text-150 .id-panel Label, .text-150 .id-panel Button { font-size: 33px; }
.text-125 .id-panel .h1 { font-size: 35px; }
.text-150 .id-panel .h1 { font-size: 42px; }
.text-125 .id-h { width: 962px; height: 607px; }
.text-150 .id-h { width: 1050px; height: 662px; }
.text-125 .id-v, .text-150 .id-v { width: 440px; height: 700px; }
.text-125 .id-readout, .text-150 .id-readout { display: flex; margin-bottom: 16px; }
.text-125 .id-panel .id-key { width: 150px; font-size: 22px; }
.text-150 .id-panel .id-key { width: 170px; font-size: 26px; }
.id-readout .id-key { color: var(--t3); }
.slice-root .id-readout .id-value { color: var(--t1); }
.counter-line { white-space: normal; }
/* REVIEW-W5N m2: compact Counter line in the ID panel header, only where the panel hides the HUD strip (125/150 %). */
.id-counter { display: none; }
.text-125 .id-counter, .text-150 .id-counter { display: flex; color: var(--t2); white-space: nowrap; flex-shrink: 1; margin: 0 16px; }
/* GAME-009 medical register (UX_PS1 §5). */
.badge { margin-right: 16px; }
.meter-caption { color: var(--t2); font-size: 18px; }
.text-125 .pos .meter-caption { font-size: 22px; }
.text-150 .pos .meter-caption { font-size: 27px; }
/* Toasts never cover the ID card: bottom-right beside the panel at 100 %, the empty top of the side column at 125/150 %. */
.id-open .toasts { left: auto; right: 96px; top: auto; bottom: 54px; width: 500px; }
.text-125.id-open .toasts, .text-150.id-open .toasts { right: 130px; top: 160px; bottom: auto; width: 540px; }

.report { width: 900px; background-color: var(--panel); border-radius: 8px; padding: 20px 28px; }

.debug { left: 96px; top: 300px; right: auto; bottom: auto; background-color: rgba(0,0,0,0.75); padding: 8px; }
.debug-title { color: var(--warn); font-size: 18px; }
.debug-line { font-size: 15px; color: var(--t2); white-space: nowrap; }
