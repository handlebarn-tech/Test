* text=auto

# Unity YAML: text, LF (Unity writes LF), no LFS
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
*.cs text diff=csharp
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.tif binary
*.fbx binary
*.glb binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.zip binary
*.pdf binary

# Git LFS for redistributable CC0/OFL third-party art only (DEC-023)
UnityProject/Assets/_Game/Art/ThirdParty/**/*.png filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.jpg filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.exr filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.hdr filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.fbx filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.glb filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.wav filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.ogg filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/ThirdParty/**/*.ttf filter=lfs diff=lfs merge=lfs -text

# Git LFS for generated procedural meshes (BUILD-005, REVIEW-W4E m3): regenerations go to LFS, older history stays as is
Art/Exports/**/*.fbx filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/_Game/Art/Procedural/**/*.fbx filter=lfs diff=lfs merge=lfs -text

# PROC-005 generated PBR finish maps (proctex.py): 2K, regenerated byte-identically
UnityProject/Assets/_Game/Art/Procedural/Textures/**/*.png filter=lfs diff=lfs merge=lfs -text
